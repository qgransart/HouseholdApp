    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nuxt/eslint": "^1.17.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "drizzle-kit": "^0.31.11",
