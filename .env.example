# Copy to `.env` for local development. Never commit real values: this repository is public.
# In production, these variables are configured in the Vercel project settings.
# Each variable is introduced by the lot that needs it (see ARCHITECTURE.md §9).

# --- Lot 4: server, database, authentication ---
# NUXT_SESSION_PASSWORD=          # ≥ 32 random characters (sealed session cookie)
# DATABASE_URL=                   # Neon Postgres connection string
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# ALLOWED_EMAILS=                 # Comma-separated allow-list of the household members' Google emails

# --- Lot 6: notifications ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=                  # mailto:… contact required by push services
# CRON_SECRET=                    # Shared secret expected by /api/cron/tick
