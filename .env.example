# Copy to `.env` for local development. Never commit real values: this repository is public.
# In production, these variables are configured in the Vercel project settings.
# Step-by-step setup of each service: docs/DEPLOIEMENT.md

# --- Server, database, authentication (lot 4) ---
NUXT_SESSION_PASSWORD=            # ≥ 32 random characters (sealed session cookie), e.g. `openssl rand -base64 32`
NUXT_DATABASE_URL=                # Neon pooled connection string (postgresql://…-pooler…/neondb?sslmode=require)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_ALLOWED_EMAILS=              # Comma-separated Google accounts of the household members

# --- Notifications (lot 6) ---
# Generate the key pair once with `npx web-push generate-vapid-keys`; changing it later
# invalidates every subscription (each phone must re-enable notifications).
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=               # mailto:you@example.com, contact required by push services
NUXT_CRON_SECRET=                 # ≥ 32 random characters, sent by cron-job.org as `Authorization: Bearer …`
